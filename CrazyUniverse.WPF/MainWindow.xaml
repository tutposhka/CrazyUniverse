<Window x:Class="CrazyUniverse.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot Planet" Height="530" Width="750">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Robot Planet"
                       FontSize="23" Margin="0,0,0,15"/>

            <TextBlock Text="Robot name:"/>
            <TextBox x:Name="NameBox" Margin="0,5,10,10"/>

            <TextBlock Text="Robot type:"/>
            <ComboBox x:Name="TypeBox" Margin="0,5,10,10"
                      SelectedIndex="0">
                <ComboBoxItem Content="CleanerBot"/>
                <ComboBoxItem Content="ExplorerBot"/>
                <ComboBoxItem Content="RepairBot"/>
                <ComboBoxItem Content="GuardBot"/>
            </ComboBox>

            <Button Content="Add robot" Height="30"
                    Margin="0,5,10,5" Click="Add_Click"/>

            <Button Content="Delete robot" Height="30"
                    Margin="0,0,10,10" Click="Delete_Click"/>

            <TextBlock Text="Robots:" FontSize="16"/>
            <ListBox x:Name="RobotList" Height="200"
                     Margin="0,5,10,0"
                     SelectionChanged="RobotList_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="15,0,0,0">
            <TextBlock Text="Robot information"
                       FontSize="20" Margin="0,0,0,10"/>

            <TextBlock x:Name="InfoText"
                       Text="Select a robot"
                       FontSize="14" Margin="0,0,0,15"/>

            <WrapPanel>
                <Button Content="Crazy Action"
                        Width="110" Height="35"
                        Margin="0,0,5,5" Click="Crazy_Click"/>

                <Button Content="Charge"
                        Width="80" Height="35"
                        Margin="0,0,5,5" Click="Charge_Click"/>

                <Button Content="Scan"
                        Width="70" Height="35"
                        Margin="0,0,5,5" Click="Scan_Click"/>

                <Button Content="Repair"
                        Width="75" Height="35"
                        Margin="0,0,5,5" Click="Repair_Click"/>
            </WrapPanel>

            <TextBlock Text="Activity log" FontSize="16"
                       Margin="0,15,0,5"/>

            <ListBox x:Name="LogList" Height="280"/>
        </StackPanel>
    </Grid>
</Window>
