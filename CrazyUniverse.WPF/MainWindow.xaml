<Window x:Class="CrazyUniverse.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Universe"
        Height="600"
        Width="900">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Robot name"/>

                <TextBox x:Name="NameBox"
                         Text="{Binding RobotName, UpdateSourceTrigger=PropertyChanged}"
                         Height="25"
                         Margin="0,5,10,10"/>

                <TextBlock Text="Robot type"/>

                <ComboBox x:Name="TypeBox"
                          ItemsSource="{Binding Types}"
                          SelectedIndex="{Binding SelectedType, Mode=TwoWay}"
                          Height="25"
                          Margin="0,5,10,10"/>

                <Button Content="Add robot"
                        Command="{Binding AddCommand}"
                        Height="30"
                        Margin="0,0,10,10"/>

                <Button Content="Delete robot"
                        Command="{Binding RemoveCommand}"
                        Height="30"
                        Margin="0,0,10,10"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Search by name"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="25"
                         Margin="0,5,10,10"/>

                <TextBlock Text="Sort"/>

                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                          Height="25"
                          Margin="0,5,10,10"/>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Robots:"
                       FontSize="16"/>

            <ListBox x:Name="RobotList"
                     Grid.Row="3"
                     ItemsSource="{Binding Robots}"
                     SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                     DisplayMemberPath="Name"
                     Margin="0,5,10,0"/>
        </Grid>

        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Robot information"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="InfoText"
                       Grid.Row="1"
                       Text="{Binding SelectedRobot.Info, TargetNullValue=Select a robot, FallbackValue=Select a robot}"
                       FontSize="14"
                       Margin="0,0,0,15"/>

            <WrapPanel Grid.Row="2">
                <Button Content="Crazy Action"
                        Command="{Binding CrazyCommand}"
                        Width="110"
                        Height="35"
                        Margin="0,0,5,5"/>

                <Button Content="Charge"
                        Command="{Binding ChargeCommand}"
                        Width="80"
                        Height="35"
                        Margin="0,0,5,5"/>

                <Button Content="Scan"
                        Command="{Binding ScanCommand}"
                        Width="70"
                        Height="35"
                        Margin="0,0,5,5"/>

                <Button Content="Repair"
                        Command="{Binding RepairCommand}"
                        Width="75"
                        Height="35"
                        Margin="0,0,5,5"/>
            </WrapPanel>

            <TextBlock Grid.Row="3"
                       Text="{Binding Stats}"
                       Margin="0,10,0,0"/>

            <TextBlock Grid.Row="4"
                       Text="Activity log"
                       FontSize="16"
                       Margin="0,15,0,5"/>

            <ListBox x:Name="LogList"
                     Grid.Row="5"
                     ItemsSource="{Binding Log}"/>
        </Grid>
    </Grid>
</Window>